# Copy to .env.local for `npm run dev`. CI reads the same values from
# .github/config/project.env. Values come from the infrastructure repo's booqy_console_deploy output.

# api_endpoint
VITE_API_URL=https://xxxxxxxxxx.execute-api.eu-north-1.amazonaws.com
# platform_operator_login.user_pool_id -> https://cognito-idp.<region>.amazonaws.com/<user_pool_id>
VITE_COGNITO_AUTHORITY=https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_XXXXXXXXX
# platform_operator_login.client_id
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# platform_operator_login.hosted_login_url
VITE_COGNITO_DOMAIN=https://dev-bsa-ops-123456789012.auth.eu-north-1.amazoncognito.com
# var.platform_domain (empty until decided) - only used for display
VITE_PLATFORM_DOMAIN=
# dev | prod - dev shows a "dev" badge (and the mail outbox); production shows nothing
VITE_ENVIRONMENT=dev
