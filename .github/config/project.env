# Shared, non-secret configuration for dev.yml / prod.yml / reusable_deploy.yml.
# Same pattern as the infrastructure repo: values are per environment
# (_DEV / _PROD suffix) and the workflow picks the right set at run time.
#
# Source of truth is the infrastructure repo's `booqy_console_deploy` output:
#   aws s3 cp s3://<state-bucket>/products/bsa/<env>/terraform.tfstate - \
#     | jq '.outputs.booqy_console_deploy.value'
# Nothing here is secret (IDs and public URLs only).
#
# Loaded into the workflow by the "Load shared project config" step.

AWS_REGION=eu-north-1

# ---------- OIDC deploy roles ----------
OIDC_ROLE_ARN_DEV=arn:aws:iam::877653167825:role/dev-platform-admin-front-end-deploy-role
OIDC_ROLE_ARN_PROD=arn:aws:iam::343695380960:role/platform-admin-front-end-deploy-role

# ---------- dev (account 877653167825) ----------
CODEDEPLOY_APP_DEV=dev-lambda-releases
ALERT_TOPIC_ARN_DEV=arn:aws:sns:eu-north-1:877653167825:dev-platform-alerts
WEB_BUCKET_DEV=dev-platform-admin-front-end-asset-877653167825
CLOUDFRONT_DISTRIBUTION_ID_DEV=E2ZTNLPRR9VXFB
ECR_REPOSITORY_DEV=dev-platform-tenants
LAMBDA_FUNCTION_NAME_DEV=dev-platform-tenants
VITE_API_URL_DEV=https://dh2m5ildm7.execute-api.eu-north-1.amazonaws.com
VITE_COGNITO_AUTHORITY_DEV=https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_DLDdKWPDb
VITE_COGNITO_CLIENT_ID_DEV=2ioqpb3vbuo2s3q2kq0cgvkbq5
VITE_COGNITO_DOMAIN_DEV=https://dev-bsa-ops-877653167825.auth.eu-north-1.amazoncognito.com
VITE_PLATFORM_DOMAIN_DEV=

# ---------- prod (account 343695380960) ----------
# Fill from the prod state before the first merge to main - the prod deploy
# fails fast while any required value below is empty.
CODEDEPLOY_APP_PROD=lambda-releases
ALERT_TOPIC_ARN_PROD=arn:aws:sns:eu-north-1:343695380960:platform-alerts
WEB_BUCKET_PROD=
CLOUDFRONT_DISTRIBUTION_ID_PROD=
ECR_REPOSITORY_PROD=
LAMBDA_FUNCTION_NAME_PROD=
VITE_API_URL_PROD=
VITE_COGNITO_AUTHORITY_PROD=
VITE_COGNITO_CLIENT_ID_PROD=
VITE_COGNITO_DOMAIN_PROD=
VITE_PLATFORM_DOMAIN_PROD=
